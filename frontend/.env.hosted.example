# Copy into a staging-only environment; never commit a real secret.
# This Neon Auth Base URL is a public browser configuration value.
VITE_ZYVELLO_HOSTED_MODE=true
VITE_NEON_AUTH_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
# Keep closed until tenant isolation and end-to-end verification have passed.
VITE_ZYVELLO_ENABLE_SIGNUP=false
